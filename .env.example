# Server
PORT=3000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=race_engineer
DB_USER=race_engineer
DB_PASSWORD=secret

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# S3 / LocalStack
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=race-engineer-conversations
S3_ENDPOINT=http://localhost:4566   # remove in production (LocalStack only)

# LLM
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3
